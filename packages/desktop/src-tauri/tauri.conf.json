{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Spleen",
  "version": "0.1.0",
  "identifier": "dev.spleen.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    },
    "trayIcon": {
      "id": "spleen-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Spleen",
    "copyright": "Copyright (c) Spleen contributors",
    "category": "DeveloperTool",
    "shortDescription": "AI coding sessions powered by OpenCode",
    "longDescription": "Spleen is a Windows desktop environment for running, supervising and recovering AI coding sessions powered by OpenCode.",
    "resources": {
      "binaries/spleen-server.exe": "binaries/spleen-server.exe",
      "resources/web-dist/": "web-dist/",
      "resources/opencode-cli/": "opencode-cli/",
      "resources/built-in-extensions/": "built-in-extensions/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    },
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/whft/spleen/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_SPLEEN_UPDATER_PUBKEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
